{
  "schema": "keddeh.braink.hr-federation/v1",
  "authority": "KEDDEH_SYSTEMS_HR + BRAINK",
  "role": "cross-sector people/agent/capability/work-module governance",
  "sector_repositories": {
    "braink_core": "aboudykeddeh276-stack/BRAINK",
    "hr_governance": "aboudykeddeh276-stack/GENERAL-GOVERNANCE-",
